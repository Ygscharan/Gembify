# ==============================================================================
# Gembify — Consultoria Lean Manufacturing com IA (Configuração do Backend)
# ==============================================================================
# Copie este arquivo para ".env" na pasta backend/ e preencha os valores abaixo:
#   Copy-Item .env.example .env
# ==============================================================================

GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo de IA padrão e fallbacks automáticos em caso de pico de demanda
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-flash-latest

# Porta do servidor HTTP da API REST
PORT=3001

# Origens permitidas no CORS (separadas por vírgula ou * em desenvolvimento)
CORS_ORIGIN=*

# ==============================================================================
# Banco de Dados PostgreSQL (Supabase, Neon, Railway ou Render)
# Se ficar vazio em desenvolvimento local, o backend usa fallback em JSON local.
# ==============================================================================
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ==============================================================================
# Conta Administrador inicial (criada automaticamente no banco ao subir o server)
# ==============================================================================
AUTH_USERNAME=Yuri
AUTH_PASSWORD=sua_senha_forte
AUTH_SECRET=gere_uma_chave_secreta_aleatoria_longa_aqui
