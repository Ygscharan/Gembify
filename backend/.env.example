# ==============================================================================
# MFV — Consultoria Lean Manufacturing com IA (Configuração do Backend)
# ==============================================================================
# Copie este arquivo para ".env" na pasta backend/ e preencha sua chave abaixo:
#   cp .env.example .env   (ou no PowerShell: Copy-Item .env.example .env)
#
# Como obter sua chave do Google Gemini:
#   1. Acesse https://aistudio.google.com/apikey
#   2. Clique em "Create API Key"
#   3. Cole a chave gerada no campo GEMINI_API_KEY abaixo
# ==============================================================================

GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo de IA padrão (pode ser trocado futuramente no .env ou no aiService.js)
# Exemplos: gemini-2.5-flash, gemini-2.5-pro
AI_MODEL=gemini-2.5-flash

# Porta do servidor HTTP da API REST
PORT=3001

# Origens permitidas no CORS (separadas por vírgula ou * em desenvolvimento)
CORS_ORIGIN=*
