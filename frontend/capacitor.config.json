{
  "appId": "com.gembify.app",
  "appName": "Gembify",
  "webDir": "dist",
  "server": {
    "url": "https://gembify.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "gembify.vercel.app",
      "*.vercel.app",
      "gembify.onrender.com"
    ]
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#000000"
  }
}
